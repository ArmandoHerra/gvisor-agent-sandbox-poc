# Required: Anthropic API key (used by direct mode and by the proxy)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Anthropic model the sandboxed agent calls, both modes (optional — default shown)
# ANTHROPIC_MODEL=claude-sonnet-5

# Optional: OpenAI API key — enables the OpenAI provider (direct mode only;
# the bundled proxy is Anthropic-specific)
# OPENAI_API_KEY=sk-proj-your-key-here

# Provider selection (optional):
#   unset      → auto-detect: OpenAI if only its key is set; Anthropic otherwise
#                (including when BOTH keys are set)
#   anthropic  → force Anthropic
#   openai     → force OpenAI
# LLM_PROVIDER=

# OpenAI model + optional output cap (defaults: gpt-5.6-sol / model default)
# OPENAI_MODEL=gpt-5.6-sol
# OPENAI_MAX_TOKENS=

# reasoning_effort sent with the run_shell tool loop (default: none — required
# for function tools on gpt-5.x reasoning models in /v1/chat/completions).
# Set to 'omit' for non-reasoning models that reject the parameter.
# OPENAI_REASONING_EFFORT=none

# Proxy settings (optional — defaults shown)
# PROXY_HOST=127.0.0.1
# PROXY_PORT=18080
# PROXY_RATE_LIMIT_RPM=60
# PROXY_RATE_LIMIT_BURST=10
# PROXY_MAX_BODY_BYTES=1048576
# PROXY_LOG_LEVEL=INFO
# PROXY_LOG_FORMAT=json
# PROXY_ALLOWED_PATHS=/v1/messages,/v1/complete,/v1/messages/batches
# PROXY_ALLOWED_EXTERNAL_HOSTS=github.com,google.com

# Capability knobs (optional — secure defaults; opt in per run)

# Enable the operator !exec REPL command (operator types it) (default: off)
# ALLOW_SHELL=1

# Enable the model-callable run_shell tool (the model runs commands itself)
# ALLOW_SHELL_TOOL=1

# Timeout in seconds, shared by !exec and the run_shell tool
# SHELL_TIMEOUT=30

# Let the agent run scripts it writes to /workspace
# WORKSPACE_EXEC=1

# Comma-separated Linux capabilities added to the bounding set
# CAP_ADD=net_bind_service

# Run the agent as uid 0 — REQUIRED for CAP_ADD to be *effective* (a non-root
# agent leaves added caps bounding-only). Still contained by gVisor's Sentry,
# not host root.
# RUN_AS_ROOT=1

# Logging settings (optional — defaults shown)
# LOG_DIR=logs
# LOG_RETENTION_DAYS=30

# Set to 1 to enable logging on all run targets
# SANDBOX_LOG_ENABLED=

# Inject timestamps into agent log lines
# LOG_TIMESTAMPS=1
